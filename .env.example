# ==============================================================================
# InvoiceCraft — Environment template (values are NOT read by the browser)
# ==============================================================================
# This file lists the CONFIGURATION KEYS only. Do NOT paste real secrets here.
#
# Backend = Cloudflare Pages + Functions + D1. Configure as follows:
#
#   Public vars      -> wrangler.toml [vars]  (or Pages dashboard "Variables")
#   Secrets          -> `wrangler secret put <NAME>` (or Pages dashboard "Secrets")
#   D1 database      -> `wrangler d1 create invoicecraft_db` then paste the
#                       returned database_id into wrangler.toml
#
# Local dev (wrangler pages dev) also supports a `.dev.vars` file (gitignored).
# ==============================================================================

# --- Google OAuth (public) ----------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Server-side secrets (use `wrangler secret put`, never commit real values) -
# SESSION_SECRET   : random 32+ byte string used to sign the login cookie
# SUPERADMIN_EMAIL : the privileged account (resolved server-side only)
# PAYMENT_WEBHOOK_SECRET : shared key in the X-Payment-Key header, used by the
#                          MacroDroid macro to confirm static-QRIS payments
SESSION_SECRET=
SUPERADMIN_EMAIL=
PAYMENT_WEBHOOK_SECRET=

# --- Cloudflare D1 (fill database_id in wrangler.toml, not here) --------------
CLOUDFLARE_D1_NAME=invoicecraft_db
